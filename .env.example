# Copy to .env.local for local development. Never commit real values.

# Public URL of the site. Defaults to the Vercel production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Phase 3: read-only GitHub token (stats, private repos). Vercel Production environment only.
# REPOS_READ_TOKEN=

# Phase 7: GitHub token with write access to this repository only. Vercel Production environment only.
# PORTFOLIO_WRITE_TOKEN=
